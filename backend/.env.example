# ============================================================================
# MULTI-BODEGA - Configuración de Ambiente Backend
# ============================================================================
# Copiar este archivo a .env y ajustar según el ambiente
# ============================================================================

# Servidor
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=multibodega

# JWT
JWT_SECRET=tu-jwt-secret-super-seguro-cambiar-en-produccion
JWT_EXPIRES_IN=7d

# CORS (separar con comas si son múltiples)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Opcional: Logging
LOG_LEVEL=debug

# Opcional: Email (para futuras funcionalidades)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password
