# ============================================================================
# MULTI-BODEGA - Git Ignore
# ============================================================================
# IMPORTANTE: Los archivos .env y .env.* CONTIENEN CREDENCIALES REALES
# NUNCA commitear archivos .env a GitHub
# ============================================================================

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build outputs
backend/dist/
frontend/.next/
frontend/out/
frontend/build/

# ---------------------------------------------------------------------------
# Environment Variables - CREDENCIALES REALES (NO COMMITEAR)
# ---------------------------------------------------------------------------
# Estos patrones IGNORAN todos los archivos .env
.env
.env.local
.env.development
.env.development.local
.env.test.local
.env.production.local
.env.production
*.env
*.env.local
.env*

# Excepciones: si necesitas commitear una plantilla, usa este patrón
# (!.env.example)

# Backend credentials
backend/.env
backend/*.env
backend/.env.*

# Frontend credentials
frontend/.env.local
frontend/.env.development.local
frontend/.env.production.local
frontend/.env.*.local

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# IDE
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.swn
*.sublime-workspace
*.sublime-project

# ---------------------------------------------------------------------------
# Coverage y Tests
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/
frontend/playwright/.auth/

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
*.pid
*.pid.lock
*.seed
*.pid
*.tgz
*.tar.gz

# Terraform
*.tfstate
*.tfstate.*
.terraform/

# PostgreSQL dumps
*.dump
*.sql.bak
